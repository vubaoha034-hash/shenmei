        "node_type",
        "editable",
        "x",
        "y",
        "width",
        "height",
        "optical_mass_relationship"
      ],
      "raster_generated_fake_typography_allowed": false
    },
    "SUPPORTING_TYPE": {
      "required_roles": [
        "ENGLISH_SUPPORT",
        "CHINESE_SUPPORT"
      ],
      "required_properties": [
        "hierarchy",
        "spacing",
        "alignment",
        "optical_offsets",
        "line_height_when_available",
        "tracking_when_available"
      ]
    },
    "PHOTO_TYPE_RELATIONSHIP": {
      "required_relationships": [
