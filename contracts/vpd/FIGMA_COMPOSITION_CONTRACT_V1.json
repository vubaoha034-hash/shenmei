  "hard_failures": {
    "raster_only_typography": "EDITABLE_DESIGN_PROVENANCE_GATE_FAIL",
    "missing_figma_file_or_frame_identity": "EDITABLE_DESIGN_PROVENANCE_GATE_FAIL",
    "missing_editable_title_nodes": "TYPOGRAPHY_DESIGN_GATE_FAIL",
    "detached_unjustified_generic_text_panel": "PHOTO_TYPE_INTEGRATION_GATE_FAIL",
    "generic_interchangeable_brand_template": "BRAND_DISTINCTIVENESS_GATE_FAIL"
