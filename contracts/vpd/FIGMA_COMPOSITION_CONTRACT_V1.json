      "exception_requires_explicit_grammar_justification": true
    },
    "GRID_SPATIAL_SYSTEM": {
      "required_fields": [
        "frame_width",
        "frame_height",
        "aspect_ratio",
        "margins",
        "primary_axes",
        "alignment_logic",
        "negative_space_regions",
        "density_rhythm"
      ]
    },
    "BRAND_DISTINCTIVENESS": {
      "transferable_relationship_explanation_required": true,
      "generic_restaurant_token_explanation_sufficient": false,
      "brand_name_swap_must_not_leave_fully_interchangeable_template": true
    },
    "EDITABILITY": {
      "editable_text_or_vector_design_layers_required": true,
      "final_export_alone_sufficient": false,
      "figma_file_key_required": true,
      "frame_node_id_required": true
    }
  },
  "receipt_requirements": {
    "figma_file_key": true,
    "frame_node_id": true,
    "contract_version_and_hash": true,
    "exact_copy": true,
    "editable_primary_title_nodes": true,
    "editable_support_copy_nodes": true,
    "source_photo_identity_and_hash": true,
    "composition_timestamp_when_available": true,
    "designer_or_agent_route_when_available": true,
    "unknown_for_unavailable_metadata": true,
    "fabricated_metadata_allowed": false
