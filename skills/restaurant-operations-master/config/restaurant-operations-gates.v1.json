    {"id":"G3","name":"menu_capacity_service","checks":["menu_role","bottleneck","peak_stress","labor","quality"],"on_fail":"REVISE_DESIGN"},
    {"id":"G4","name":"customer_brand","checks":["customer_job","value_clear","behavior_change","repeat","brand_guardrail"],"on_fail":"HYPOTHESIS_ONLY"},
    {"id":"G5","name":"supplier_food_safety","checks":["qualification","traceability","temperature","process","records","emergency"],"on_fail":"STOP"},
    {"id":"G6","name":"independent_panel","checks":["customer","front","kitchen","finance","brand","safety","locked"],"on_fail":"REVIEW_REQUIRED"},
