{
  "schema_version":"restaurant_operations_gates_v1",
  "principles":{"baseline_before_solution":true,"contribution_before_revenue":true,"food_safety_blocker":true,"independent_store_panels":true,"pilot_before_rollout":true,"single_store_success_not_standard":true},
