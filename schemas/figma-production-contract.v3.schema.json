{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "figma-production-contract.v3.schema.json",
  "title": "Figma Production Contract V3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "contract_id", "program_id", "family_id", "typography_hypothesis_id",
    "contract_status", "runtime_status", "production_layer_scope", "live_text_vs_vector_policy",
    "typography_tokens", "layout_contract", "copy_fidelity_rules", "componentization_plan",
    "quality_gate_for_figma_output", "fail_closed_conditions", "unresolved_dependencies", "evidence_lineage"
  ],
  "properties": {
    "schema_version": {"const": "3.0.0"},
    "contract_id": {"type": "string"},
    "program_id": {"type": "string"},
    "family_id": {"type": "string"},
    "typography_hypothesis_id": {"type": "string"},
    "contract_status": {"const": "FIGMA_CONTRACT_READY"},
    "runtime_status": {"enum": ["FIGMA_RUNTIME_UNVERIFIED", "FIGMA_RUNTIME_VERIFIED", "FIGMA_RUNTIME_UNAVAILABLE_IN_CURRENT_CONTEXT"]},
    "production_layer_scope": {
      "type": "object", "additionalProperties": false,
      "required": ["figma_owns", "figma_may_place", "figma_must_not_own"],
      "properties": {
        "figma_owns": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "figma_may_place": {"type": "array", "items": {"type": "string"}},
        "figma_must_not_own": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "live_text_vs_vector_policy": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["role", "policy", "dependency", "reason"],
        "properties": {
          "role": {"type": "string"},
          "policy": {"enum": ["LIVE_TEXT_REQUIRED", "LIVE_TEXT_PREFERRED", "VECTOR_ASSET_REQUIRED", "APPROVED_DISPLAY_ASSET", "NOT_FIGMA_ZERO_TO_ONE"]},
          "dependency": {"type": ["string", "null"]},
          "reason": {"type": "string"}
        }
      }
    },
    "typography_tokens": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["role", "font_family", "fallback", "weight", "size_range", "tracking", "line_height", "text_color_token", "opacity", "alignment", "min_width", "max_width", "baseline_grid_relation"],
        "properties": {
          "role": {"type": "string"},
          "font_family": {"type": "string"},
          "fallback": {"type": "array", "items": {"type": "string"}},
          "weight": {"type": ["string", "number"]},
          "size_range": {
            "type": "object", "additionalProperties": false, "required": ["min", "max", "unit"],
            "properties": {"min": {"type": "number", "minimum": 0}, "max": {"type": "number", "minimum": 0}, "unit": {"enum": ["px", "percent_of_short_edge"]}}
          },
          "tracking": {"type": ["number", "string"]},
          "line_height": {"type": ["number", "string"]},
          "text_color_token": {"type": "string"},
          "opacity": {"type": "number", "minimum": 0, "maximum": 1},
          "alignment": {"enum": ["LEFT", "CENTER", "RIGHT", "JUSTIFIED", "VERTICAL"]},
          "min_width": {"type": ["number", "null"]},
          "max_width": {"type": ["number", "null"]},
          "baseline_grid_relation": {"type": ["string", "null"]}
        }
      }
    },
    "layout_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["safe_margins", "alignment_axes", "title_zone", "support_copy_zone", "side_rail", "footer_lockup", "aspect_ratio_adaptation", "thumbnail_priority", "overlap_avoidance_constraints"],
      "properties": {
        "safe_margins": {"type": "object"},
        "alignment_axes": {"type": "array", "items": {"type": "string"}},
        "title_zone": {"type": "string"},
        "support_copy_zone": {"type": "string"},
        "side_rail": {"type": "string"},
        "footer_lockup": {"type": "string"},
        "aspect_ratio_adaptation": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "thumbnail_priority": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "overlap_avoidance_constraints": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "copy_fidelity_rules": {
      "type": "object", "additionalProperties": false,
      "required": ["VERBATIM_REQUIRED", "PLACEHOLDER_ALLOWED", "HUMAN_APPROVAL_REQUIRED"],
      "properties": {
        "VERBATIM_REQUIRED": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "PLACEHOLDER_ALLOWED": {"type": "array", "items": {"type": "string"}},
        "HUMAN_APPROVAL_REQUIRED": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "componentization_plan": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["element", "implementation", "reusable", "variants_or_variables", "dependencies"],
        "properties": {
          "element": {"type": "string"},
          "implementation": {"enum": ["FIGMA_COMPONENT", "VARIANTS", "VARIABLES", "STYLE", "REUSABLE_VECTOR_ASSET", "ONE_OFF_ART_ASSET"]},
          "reusable": {"type": "boolean"},
          "variants_or_variables": {"type": "array", "items": {"type": "string"}},
          "dependencies": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "quality_gate_for_figma_output": {"type": "array", "minItems": 10, "uniqueItems": true, "items": {"type": "string"}},
    "fail_closed_conditions": {"type": "array", "minItems": 6, "uniqueItems": true, "items": {"type": "string"}},
    "unresolved_dependencies": {"type": "array", "items": {"type": "string"}},
    "runtime_receipt": {"type": ["string", "null"]},
    "evidence_lineage": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
  }
}
