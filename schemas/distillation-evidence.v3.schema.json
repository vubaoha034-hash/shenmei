{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "distillation-evidence.v3.schema.json",
  "title": "Visual Distillation Deep Evidence V3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_object_id", "status", "subject", "analysis", "evidence_lineage"],
  "properties": {
    "schema_version": {"const": "3.0.0"},
    "evidence_object_id": {"type": "string", "minLength": 1},
    "status": {"const": "DEEP_EVIDENCE"},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family_id", "canonical_asset_id", "canonical_sample_id", "canonical_sha256", "canonical_dimensions"],
      "properties": {
        "family_id": {"type": "string"},
        "canonical_asset_id": {"type": "string"},
        "canonical_sample_id": {"type": "string"},
        "canonical_sha256": {"type": "string", "pattern": "^(sha256:)?[0-9a-f]{64}$"},
        "canonical_dimensions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height"],
          "properties": {"width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}}
        }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["photography", "graphic_design", "integration"],
      "properties": {
        "photography": {"$ref": "#/$defs/evidenceList"},
        "graphic_design": {"$ref": "#/$defs/evidenceList"},
        "integration": {"$ref": "#/$defs/evidenceList"}
      }
    },
    "evidence_lineage": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "v2_migration": {"type": "array", "items": {"$ref": "#/$defs/migration"}}
  },
  "$defs": {
    "evidenceList": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidenceItem"}},
    "evidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "dimension", "claim", "evidence_class", "confidence", "evidence_pointer", "uncertainty", "binding_classification"],
      "properties": {
        "evidence_id": {"type": "string"},
        "dimension": {"type": "string"},
        "claim": {"type": "string"},
        "evidence_class": {"enum": ["DIRECT_VISIBLE", "METADATA", "INFERENCE"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence_pointer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["asset_id", "sha256", "region"],
          "properties": {
            "asset_id": {"type": "string"},
            "sha256": {"type": "string", "pattern": "^(sha256:)?[0-9a-f]{64}$"},
            "region": {"type": "string"}
          }
        },
        "uncertainty": {"type": ["string", "null"]},
        "measurements": {"type": "object"},
        "binding_classification": {"enum": ["STYLE_SIGNATURE", "CONTENT_BOUND", "BRAND_BOUND", "PRODUCTION_BOUND", "OPTIONAL_VARIATION"]}
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v2_field", "v3_field", "semantic_change"],
      "properties": {
        "v2_field": {"type": "string"},
        "v3_field": {"type": "string"},
        "semantic_change": {"type": "string"}
      }
    }
  }
}
