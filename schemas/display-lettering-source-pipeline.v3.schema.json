{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "display-lettering-source-pipeline.v3.schema.json",
  "title": "Display Lettering Source Pipeline V3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "pipeline_id", "status", "routes", "required_common_record", "approval_boundary", "figma_boundary", "promotion_status"],
  "properties": {
    "schema_version": {"const": "3.0.0"},
    "pipeline_id": {"type": "string", "minLength": 1},
    "status": {"const": "CONTRACT_READY"},
    "routes": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["route", "source_requirements", "allowed_transformations", "fail_closed_conditions"],
        "properties": {
          "route": {"enum": ["APPROVED_FONT_PLUS_CONTROLLED_DEFORMATION", "SPECIALIZED_VISUAL_SYNTHESIS_TO_APPROVED_ASSET", "HUMAN_OR_EXISTING_VECTOR_ASSET"]},
          "source_requirements": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "allowed_transformations": {"type": "array", "items": {"type": "string"}},
          "fail_closed_conditions": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "required_common_record": {"type": "array", "minItems": 11, "uniqueItems": true, "items": {"type": "string"}},
    "approval_boundary": {"const": "HUMAN_REVIEW_REQUIRED_BEFORE_APPROVED_ASSET"},
    "figma_boundary": {"const": "PLACE_OR_CONTROLLED_TRANSFORM_APPROVED_SOURCE_NOT_ZERO_TO_ONE"},
    "promotion_status": {"const": "UNPROMOTED"}
  }
}
