{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "typography-distillation-hypothesis.v3.schema.json",
  "title": "Typography Distillation Hypothesis V3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_type", "hypothesis_id", "family_id", "status", "review_status",
    "source_evidence_ids", "typography_visual_philosophy", "stable_typography_grammar",
    "variation_axes_typography", "content_bound_typography", "brand_bound_typography",
    "production_bound_typography", "typography_content_compatibility", "figma_execution_hypothesis",
    "transfer_risks", "unresolved_uncertainties", "component_approval_status", "promotion_status", "evidence_lineage"
  ],
  "properties": {
    "schema_version": {"const": "3.0.0"},
    "artifact_type": {"const": "TYPOGRAPHY_DISTILLATION_HYPOTHESIS"},
    "hypothesis_id": {"type": "string"},
    "family_id": {"type": "string"},
    "status": {"enum": ["DISTILLATION_HYPOTHESIS", "PROVISIONAL_PROGRAM_COMPONENT"]},
    "review_status": {"enum": ["HUMAN_REVIEW_PENDING", "HUMAN_REVIEWED"]},
    "source_evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "typography_visual_philosophy": {"$ref": "#/$defs/claim"},
    "stable_typography_grammar": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/grammar"}},
    "variation_axes_typography": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
    "content_bound_typography": {"type": "array", "items": {"$ref": "#/$defs/bound"}},
    "brand_bound_typography": {"type": "array", "items": {"$ref": "#/$defs/bound"}},
    "production_bound_typography": {"type": "array", "items": {"$ref": "#/$defs/bound"}},
    "typography_content_compatibility": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/claim"}},
    "figma_execution_hypothesis": {
      "type": "object", "additionalProperties": false,
      "required": ["renderer_responsibility", "figma_responsibility", "not_figma_zero_to_one", "required_dependencies", "evidence_ids"],
      "properties": {
        "renderer_responsibility": {"type": "array", "items": {"type": "string"}},
        "figma_responsibility": {"type": "array", "items": {"type": "string"}},
        "not_figma_zero_to_one": {"const": true},
        "required_dependencies": {"type": "array", "items": {"type": "string"}},
        "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "transfer_risks": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "unresolved_uncertainties": {"type": "array", "items": {"type": "string"}},
    "component_approval_status": {"const": "UNCONFIRMED"},
    "promotion_status": {"const": "UNPROMOTED"},
    "evidence_lineage": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
  },
  "$defs": {
    "claim": {
      "type": "object", "additionalProperties": false, "required": ["statement", "confidence", "evidence_ids"],
      "properties": {
        "statement": {"type": "string"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "grammar": {
      "type": "object", "additionalProperties": false, "required": ["mechanism_id", "statement", "state", "confidence", "evidence_ids"],
      "properties": {
        "mechanism_id": {"type": "string"},
        "statement": {"type": "string"},
        "state": {"const": "INVARIANT_HYPOTHESIS"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "bound": {
      "type": "object", "additionalProperties": false, "required": ["features", "transfer_behavior", "evidence_ids"],
      "properties": {
        "features": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "transfer_behavior": {"type": "string"},
        "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    }
  }
}
