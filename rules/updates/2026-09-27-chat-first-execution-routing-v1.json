  "status": "CANONICAL_ACTIVE",
  "repository": "vubaoha034-hash/shenmei",
  "branch": "main",
  "default_mode": "CHAT",
  "default_chat_thinking_effort": "EXTREME_HIGH",
  "routing_layers": {
    "execution_surface": "This artifact chooses the execution surface only.",
    "content_route": "START_HERE.md six-route content/aesthetic/business routing remains independently authoritative."
  },
  "chat_default_covers": [
    "aesthetic analysis",
    "visual critique and scoring",
    "solution / brief / prompt work",
    "web search and webpage reading",
    "ordinary browser clicking and navigation",
    "ordinary Figma viewing / inspection when Chat has the required capability",
    "asset and reference browsing"
  ],
  "work_if_materially_better": [
    "unusually long autonomous workflow",
    "multi-App or multi-website continuous coordination",
    "many-step execution where Chat is materially more fragmented, slower, or less stable",
    "a required capability is genuinely Work-only"
  ],
  "codex_local": [
    "full local repository",
    "Shell",
    "Python",
    "unit or integration tests",
    "dependency installation",
    "build or compilation",
    "bulk file processing",
    "large-scale local Git operations"
  ],
  "hard_clarifications": {
    "website_does_not_imply_work": true,
    "figma_page_does_not_imply_work": true,
    "figma_content_route_does_not_imply_work": true,
    "editable_figma_formal_brand_system_content_route_preserved": true
  },
  "regression_expectations": {
    "CASE_A": "CHAT_EXTREME_HIGH",
    "CASE_B": "CHAT_EXTREME_HIGH_UNLESS_A_SPECIFIC_REQUIRED_CAPABILITY_IS_UNAVAILABLE",
    "CASE_C": "WORK_IF_MATERIALLY_BETTER",
    "CASE_D": "CODEX_LOCAL",
    "CASE_E": {
      "content_route": "EDITABLE_FIGMA_FORMAL_BRAND_SYSTEM",
      "execution_surface": "CHAT_FIRST_THEN_WORK_ONLY_IF_MATERIALLY_BETTER_OR_REQUIRED"
    }
  },
  "forbidden_interpretations": [
    "web activity mechanically triggers Work",
    "Figma viewing mechanically triggers Work",
    "Figma formal brand-system content routing mechanically triggers Work",
    "Codex is used for ordinary web or visual-review tasks",
    "Git task/project page/filled prompt alone proves Chat started",
    "unreadable Chat proves prior visual generation did not happen",
    "unreadable Chat authorizes Retry or duplicate visual generation"
  ],
  "aesthetic_rule_changes": "NONE",
  "visual_generation": "NONE",
  "execution_reliability_gate": {
    "status": "CANONICAL_ACTIVE",
    "contract_path": "rules/updates/2026-09-27-chat-execution-reliability-contract-v1.json",
    "precedence": "MUST_PASS_RELEVANT_RELIABILITY_GATE_BEFORE_REPORTING_START_OR_FRESH_RECOVERY",
    "dispatch_confirmation": {
      "pass_requires_all": [
        "post-send current-project /c/... conversation URL",
        "positively observed active processing/response started"
      ],
      "pass_status": "PASS_STARTED",
      "failure_code": "CHAT_DISPATCH_SEND_NOT_CONFIRMED",
      "insufficient_evidence": [
        "Git task exists",
        "project page exists",
        "prompt filled",
        "send/Enter attempted without post-send confirmation"
      ]
    },
    "unreadable_conversation_recovery": {
      "on_unreadable_after_confirmed_start": "STOP_AND_DO_NOT_RETRY",
      "durable_output_exists": "RECOVER_EXISTING_OUTPUT_NO_RERUN",
      "no_output_old_task_not_blocked": "BLOCK_OLD_TASK_NO_RETRY",
      "fresh_recovery_preconditions": [
        "old execution task blocked",
        "no durable output exists",
        "frozen scope unchanged",
        "authority/head unchanged",
        "new Chat passes CHAT_DISPATCH_CONFIRMATION"
      ],
      "authority_or_head_drift": "STOP_REBASE_REQUIRED"
    },
    "visual_duplicate_prevention": {
      "future_visual_task_required_declarations": [
        "generation_count_max or equivalent",
        "expected durable output identity/path/manifest when applicable",
        "reroll policy",
        "hidden variant policy",
        "publish/write policy"
      ],
      "unreadable_ui_never_authorizes_regeneration": true,
      "missing_chat_view_does_not_prove_generation_absent": true,
      "fresh_recovery_may_not_silently_increase_generation_or_variant_budget": true
    }
  }
